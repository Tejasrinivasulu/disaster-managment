# Application
APP_NAME=AI Disaster Response Management System
APP_ENV=development
DEBUG=true
DEMO_MODE=true
SECRET_KEY=change-this-to-a-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256

# CORS — include your Vercel URL after frontend deploy
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://YOUR-APP.vercel.app
# Optional regex for all Vercel preview URLs (default in config.py)
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/disaster_response
# Fallback SQLite for local development without PostgreSQL:
# DATABASE_URL=sqlite:///./disaster_response.db

# External APIs (leave empty for demo mode)
GDACS_API_URL=
USGS_API_URL=
NDMA_API_URL=
OSRM_API_URL=

# ML
ML_MODELS_DIR=../ml/models
ML_RESULTS_DIR=../ml/results
